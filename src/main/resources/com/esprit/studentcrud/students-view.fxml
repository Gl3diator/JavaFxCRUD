<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="520.0" prefWidth="850.0"
            style="-fx-background-color: #F3F4F6;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.studentcrud.controller.StudentController">

    <top>
        <HBox prefHeight="70.0" spacing="10.0"
              style="-fx-background-color: #111827; -fx-alignment: center-left;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
            </padding>
            <children>
                <Label text="Student CRUD"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                <Label text=" • JavaFX + MariaDB"
                       style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;" />
            </children>
        </HBox>
    </top>

    <center>
        <BorderPane BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
            <center>
                <TableView fx:id="tableStudents"
                           style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #E5E7EB;"
                           BorderPane.alignment="CENTER">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="180.0" text="Name" />
                        <TableColumn fx:id="colAge" prefWidth="80.0" text="Age" />
                        <TableColumn fx:id="colEmail" prefWidth="420.0" text="Email" />
                    </columns>
                </TableView>
            </center>
        </BorderPane>
    </center>

    <bottom>
        <VBox spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #E5E7EB;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>

            <children>

                <Label text="Student form"
                       style="-fx-text-fill: #111827; -fx-font-size: 14px; -fx-font-weight: bold;" />

                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90.0" prefWidth="110.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="30.0" />
                        <RowConstraints prefHeight="30.0" />
                        <RowConstraints prefHeight="30.0" />
                    </rowConstraints>

                    <children>
                        <Label text="Name" style="-fx-text-fill: #374151; -fx-font-weight: bold;" />
                        <Label text="Age" GridPane.rowIndex="1" style="-fx-text-fill: #374151; -fx-font-weight: bold;" />
                        <Label text="Email" GridPane.rowIndex="2" style="-fx-text-fill: #374151; -fx-font-weight: bold;" />

                        <TextField fx:id="txtName" GridPane.columnIndex="1"
                                   promptText="Enter name"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 8;" />

                        <TextField fx:id="txtAge" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                   promptText="Enter age"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 8;" />

                        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                   promptText="name@mail.com"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D1D5DB; -fx-padding: 8;" />
                    </children>
                </GridPane>

                <HBox spacing="10.0" style="-fx-alignment: center-left;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onAdd" text="Add"
                                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14;" />

                        <Button mnemonicParsing="false" onAction="#onUpdate" text="Update"
                                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14;" />

                        <Button mnemonicParsing="false" onAction="#onDelete" text="Delete"
                                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14;" />

                        <Button mnemonicParsing="false" onAction="#onClear" text="Clear"
                                style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14;" />

                        <Button mnemonicParsing="false" onAction="#onRefresh" text="Refresh"
                                style="-fx-background-color: white; -fx-text-fill: #111827; -fx-border-color: #D1D5DB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 14;" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </bottom>
</BorderPane>
